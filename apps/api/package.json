{
  "name": "@inspector/api",
  "version": "0.1.0",
  "private": true,
  "description": "Инспектор ИИ: REST API (NestJS 11 + Fastify 5, Drizzle, PostgreSQL). Владелец: AG-08.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --enable-source-maps -r @swc-node/register src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node -r @swc-node/register src/db/create-db.ts --test && vitest run --config vitest.db.config.mts",
    "db:create": "node -r @swc-node/register src/db/create-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -r @swc-node/register src/db/migrate.ts",
    "db:seed": "node -r @swc-node/register src/modules/auth/seed.ts",
    "fixture:inventory": "node -r @swc-node/register scripts/make-inventory-run.ts",
    "fixture:d1": "node -r @swc-node/register scripts/make-d1-fixture-run.ts"
  },
  "dependencies": {
    "@inspector/contracts": "workspace:*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-fastify": "^11.2.6",
    "@node-rs/argon2": "^2.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-i18n": "^4.2.0",
    "amqplib": "^2.1.0",
    "cookie": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "5.11.3",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.2.1",
    "openapi-backend": "^5.21.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.6",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
