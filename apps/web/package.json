{
  "name": "@inspector/web",
  "version": "0.1.0",
  "private": true,
  "description": "Инспектор ИИ: веб-интерфейс (React 19, Vite, Ant Design ru_RU, TanStack Query). Владелец: AG-08.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "node scripts/gen-api-types.mjs",
    "dev:mock": "VITE_API_MOCK=1 vite"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fontsource/golos-text": "^5.3.0",
    "@inspector/contracts": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "openseadragon": "^6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/openseadragon": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
