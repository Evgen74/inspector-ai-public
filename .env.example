# «Инспектор ИИ» — local settings. Copy to .env (git-ignored); the Makefile loads it.
# Everything runs locally: no Docker, no network calls at runtime.

# Python interpreter for uv. macOS: Homebrew Python 3.12 (do not add a .python-version file: uv here is a pyenv shim).
# Linux: leave unset (the Makefile takes python3.12 from PATH) or point to your own, e.g. /usr/bin/python3.12.
UV_PYTHON=/opt/homebrew/bin/python3.12

# Organizer data (read-only): the decoded mirror with ПАКЕТ_УЧАСТНИКАМ_БЕЗ_ОТВЕТОВ_v2.0/ and ХАКАТОН_УЧАСТНИКАМ_ГОТОВО_К_ПЕРЕДАЧЕ/.
# Defaults are relative to the repository root.
# INSPECTOR_DATA_ROOT=/Users/evgen/pl/hackaton/data_utf8
# INSPECTOR_MODELS_ROOT=/Users/evgen/pl/hackaton/.models
# INSPECTOR_CACHE_ROOT=/Users/evgen/pl/hackaton/.cache
# INSPECTOR_RUNS_ROOT=/Users/evgen/pl/hackaton/runs

# Logging: json (default, one object per line) or console.
INSPECTOR_LOG_LEVEL=INFO
INSPECTOR_LOG_FORMAT=console

# Batch execution: process-pool size (0 = cpu_count - 2).
INSPECTOR_WORKERS=0
# Recognition executor is chosen by the code itself (`--providers auto`: CoreML on macOS -> CUDA on an NVIDIA GPU
# that really works -> CPU). Optional GPU tuning: INSPECTOR_CUDA_DEVICE=0, INSPECTOR_CUDA_MAX_WORKERS=4,
# INSPECTOR_CUDA_MEM_LIMIT_MB= (per session). Check with `make gpu-check`.

# Web mode only (not used by inspector-batch). Local Homebrew services.
INSPECTOR_DATABASE_URL=postgresql://localhost:5432/inspector
INSPECTOR_REDIS_URL=redis://localhost:6379/0
# API (apps/api): environment local|test|demo|prod (responses are validated against OpenAPI outside prod),
# bind address and port; the web dev server (apps/web, :5173) proxies /api to it.
INSPECTOR_APP_ENV=local
INSPECTOR_API_HOST=127.0.0.1
INSPECTOR_API_PORT=3000
# Database for `make test-db` (created and migrated by the test run); its Redis db is flushed by the tests.
INSPECTOR_TEST_DATABASE_URL=postgresql://localhost:5432/inspector_test
INSPECTOR_TEST_REDIS_URL=redis://127.0.0.1:6379/15
# Auth (AG-00): `required` (default in demo/prod) or `optional` (default in local/test: requests without a session
# pass as anonymous until the web login screen is used; refused in demo/prod). Sessions live in Redis.
# INSPECTOR_AUTH_MODE=required
# INSPECTOR_SESSION_IDLE_MIN=30
# INSPECTOR_SESSION_ABSOLUTE_H=12
# INSPECTOR_SESSION_MAX_PER_USER=3
# INSPECTOR_COOKIE_SECURE=false          # true → cookie `__Host-ii_sid` + Secure (HTTPS only; default in prod)
# Demo accounts (`make db-seed`): password for all seven, default Demo-Inspector-2026.
# INSPECTOR_DEMO_PASSWORD=Demo-Inspector-2026
# Internal ml-api (services/ml/apps/ml_api, `make ml-api-dev`): PDF page renders for the evidence viewer.
INSPECTOR_ML_API_URL=http://127.0.0.1:8090
# INSPECTOR_ML_API_PORT=8090
# INSPECTOR_ML_API_WORKERS=1
# INSPECTOR_ML_API_TOKEN=                # shared secret (X-Service-Token) when set on both sides
# INSPECTOR_ML_API_TIMEOUT_MS=30000
# Uploaded package: --workers of its batch run (default: auto = 75 % of the CPUs, see INSPECTOR_RESOURCE_CAP).
# INSPECTOR_UPLOAD_WORKERS=
# Share of the machine an analysis may use (CPUs and memory; every process pool of the pipeline is capped by it).
# INSPECTOR_RESOURCE_CAP=0.75
# INSPECTOR_WORKER_MEM_MB=1024           # memory assumed per worker process when the pool size is computed

# Docker (`docker compose up -d`, docs/runbook/DOCKER.md): compose reads these from this directory's .env for its own
# ${...} substitutions only (the containers get their settings from docker-compose.yml; the native values above are not used).
# INSPECTOR_HTTP_PORT=8080               # host port of the web container
# INSPECTOR_DB_PASSWORD=inspector        # PostgreSQL and RabbitMQ password inside the compose network (letters and digits only)
# INSPECTOR_DEMO_PASSWORD=Demo-Inspector-2026
# INSPECTOR_UPLOAD_WORKERS=              # empty = auto (75 % of the container's CPUs)
# INSPECTOR_RESOURCE_CAP=0.75
# INSPECTOR_DATA_HOST_PATH=/path/to/data_utf8   # only with docker-compose.data.yml
