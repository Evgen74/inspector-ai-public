{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.inspector-ai.local/schemas/gold_check.schema.json",
  "title": "GoldCheck",
  "description": "One row of the organizers' public_train_checks.jsonl (train gold). Also the shape of our own N-GOLD labels (Новослободская, badged «разметка команды»). Owner: AG-10.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "check_id",
    "finding_group_id",
    "object_id",
    "split",
    "matrix_scope",
    "parameter_code",
    "location_type",
    "location",
    "violation_label",
    "protocol_status",
    "criticality",
    "evidence"
  ],
  "properties": {
    "check_id": {"type": "string", "minLength": 1},
    "finding_group_id": {"type": "string", "minLength": 1},
    "object_id": {"$ref": "common.schema.json#/$defs/ObjectId"},
    "split": {"$ref": "enums.schema.json#/$defs/ManifestSplit"},
    "visibility": {"type": "string"},
    "matrix_scope": {"$ref": "enums.schema.json#/$defs/MatrixScope"},
    "parameter_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/ParamId"}, {"type": "null"}]},
    "parameter_code": {"$ref": "common.schema.json#/$defs/SubmissionParameterCode"},
    "location_type": {"$ref": "enums.schema.json#/$defs/LocationType"},
    "location": {"$ref": "common.schema.json#/$defs/Location"},
    "pd_value": {"$ref": "common.schema.json#/$defs/StageValue"},
    "rd_value": {"$ref": "common.schema.json#/$defs/StageValue"},
    "id_value": {"$ref": "common.schema.json#/$defs/StageValue"},
    "comparison_result": {"oneOf": [{"$ref": "enums.schema.json#/$defs/ComparisonResult"}, {"type": "null"}]},
    "violation_label": {"$ref": "enums.schema.json#/$defs/ViolationLabel"},
    "protocol_status": {"$ref": "enums.schema.json#/$defs/ProtocolParamStatus"},
    "criticality": {"$ref": "common.schema.json#/$defs/CriticalityString"},
    "document_status": {"oneOf": [{"$ref": "enums.schema.json#/$defs/DocumentStatus"}, {"type": "null"}]},
    "inspector_status": {"type": ["string", "null"], "description": "v1.0 vocabulary (CONFIRMED, REJECTED) — aliases of InspectorStatus."},
    "gold_status": {"$ref": "enums.schema.json#/$defs/GoldStatus"},
    "score_eligible": {"type": "boolean"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/GoldEvidence"}}
  },
  "$defs": {
    "GoldEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["stage", "file_id", "pdf_page_number"],
      "properties": {
        "stage": {"$ref": "enums.schema.json#/$defs/DocStage"},
        "file_id": {"$ref": "common.schema.json#/$defs/ManifestFileId"},
        "pdf_page_number": {"$ref": "common.schema.json#/$defs/PageNumber"},
        "document_sheet_number": {"$ref": "common.schema.json#/$defs/SheetNumber"},
        "rendered_image": {"type": ["string", "null"]},
        "localization": {"$ref": "enums.schema.json#/$defs/EvidenceLocalization"}
      }
    }
  }
}
