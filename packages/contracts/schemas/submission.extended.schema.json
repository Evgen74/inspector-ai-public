{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.inspector-ai.local/schemas/submission.extended.schema.json",
  "title": "ИИ-инспектор: ответ участника (full, with gold-named extras)",
  "description": "The full submission written to `submission/<object_id>.json` (93 §3.9, 97 §2.5): the organizer schema plus the optional gold-named extras (comparison_result, location_type, document_status, matrix_scope, parameter_mapping_status, finding_id, confidence, evidence document_sheet_number). No other fields are allowed. Owner: AG-04.",
  "allOf": [
    {"$ref": "submission.organizer.schema.json"},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "checks"],
      "properties": {
        "object_id": {"$ref": "common.schema.json#/$defs/ObjectId"},
        "checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/Check"}
        }
      }
    }
  ],
  "$defs": {
    "Check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_code", "location", "violation_label", "evidence"],
      "properties": {
        "parameter_code": {"$ref": "common.schema.json#/$defs/SubmissionParameterCode"},
        "location": {"$ref": "common.schema.json#/$defs/Location"},
        "pd_value": {"$ref": "common.schema.json#/$defs/StageValue"},
        "rd_value": {"$ref": "common.schema.json#/$defs/StageValue"},
        "id_value": {"$ref": "common.schema.json#/$defs/StageValue"},
        "violation_label": {"$ref": "enums.schema.json#/$defs/ViolationLabel"},
        "protocol_status": {"enum": ["OK", "WARNING", "CRITICAL", "ID_MISSING", "RD_MISSING", "PD_MISSING", "COMPARISON_IMPOSSIBLE"]},
        "criticality": {"$ref": "common.schema.json#/$defs/CriticalityString"},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "file_id", "pdf_page_number"],
            "properties": {
              "stage": {"$ref": "enums.schema.json#/$defs/DocStage"},
              "file_id": {"$ref": "common.schema.json#/$defs/ManifestFileId"},
              "pdf_page_number": {"$ref": "common.schema.json#/$defs/PageNumber"},
              "document_sheet_number": {"$ref": "common.schema.json#/$defs/SheetNumber"}
            }
          }
        },
        "comparison_result": {"oneOf": [{"$ref": "enums.schema.json#/$defs/ComparisonResult"}, {"type": "null"}]},
        "location_type": {"$ref": "enums.schema.json#/$defs/LocationType"},
        "document_status": {"oneOf": [{"$ref": "enums.schema.json#/$defs/DocumentStatus"}, {"type": "null"}]},
        "matrix_scope": {"$ref": "enums.schema.json#/$defs/MatrixScope"},
        "parameter_mapping_status": {"$ref": "enums.schema.json#/$defs/ParameterMappingStatus"},
        "finding_id": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "common.schema.json#/$defs/Confidence"}
      }
    }
  }
}
