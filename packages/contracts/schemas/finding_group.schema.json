{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.inspector-ai.local/schemas/finding_group.schema.json",
  "title": "FindingGroup",
  "description": "One discrepancy as the engine sees it before the atomic split (97 §2.5, §2.10; 93 §2.8): one parameter code, one comparison result, one element family, one or more locations. The group owns the anchor pages (one per stage), reused by every atomic Finding split from it (`finding_ids`, one per location). Gold analogue: public_train_finding_groups.jsonl. Written as JSONL to runs/<run_id>/findings/<object_id>.groups.jsonl. Owner: AG-04 (matrix groups), AG-07 (FREE-* groups).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_group_id",
    "object_id",
    "matrix_scope",
    "parameter_code",
    "comparison_result",
    "location_type",
    "locations",
    "violation_label",
    "protocol_status",
    "criticality",
    "anchor_evidence",
    "finding_ids"
  ],
  "properties": {
    "finding_group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "description": "Stable id, e.g. «OBJ-TYUMENSKAYA-5-GOLD-SEED-G-IOS4-078-CFG-01». Atomic children use it as `finding_group_id`."
    },
    "object_id": {"$ref": "common.schema.json#/$defs/ObjectId"},
    "run_id": {"type": ["string", "null"]},
    "matrix_scope": {"$ref": "enums.schema.json#/$defs/MatrixScope"},
    "parameter_code": {"$ref": "common.schema.json#/$defs/SubmissionParameterCode"},
    "parameter_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/ParamId"}, {"type": "null"}]},
    "parameter_mapping_status": {"$ref": "enums.schema.json#/$defs/ParameterMappingStatus"},
    "alt_parameter_codes": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/CanonicalParameterCode"},
      "description": "Runner-up codes of the top-2 hedge (97 §1.6), best first."
    },
    "hedge_kind": {"oneOf": [{"$ref": "enums.schema.json#/$defs/HedgeKind"}, {"type": "null"}]},
    "hedge_of_group_id": {"type": ["string", "null"], "description": "Set on the hedge twin of another group (same locations, runner-up code)."},
    "title": {"type": ["string", "null"], "description": "Russian one-liner, e.g. «Отсутствует местная вытяжная вентиляция в помещениях 140, 142»."},
    "element_noun": {"type": ["string", "null"], "description": "Element noun of the value templates (93 §3.5), e.g. «Тёплый пол», «Приточная установка»."},
    "axis": {"$ref": "enums.schema.json#/$defs/ComparisonAxis"},
    "comparison_result": {"$ref": "enums.schema.json#/$defs/ComparisonResult"},
    "discrepancy_type": {"oneOf": [{"$ref": "enums.schema.json#/$defs/DiscrepancyType"}, {"type": "null"}]},
    "location_type": {"$ref": "enums.schema.json#/$defs/LocationType"},
    "locations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/Location"},
      "description": "Exact printed tokens («012», not «12»); one atomic Finding per item."
    },
    "pd_value": {"$ref": "common.schema.json#/$defs/StageValue"},
    "rd_value": {"$ref": "common.schema.json#/$defs/StageValue"},
    "id_value": {"$ref": "common.schema.json#/$defs/StageValue"},
    "violation_label": {"$ref": "enums.schema.json#/$defs/ViolationLabel"},
    "protocol_status": {"$ref": "enums.schema.json#/$defs/ProtocolParamStatus"},
    "criticality": {"$ref": "common.schema.json#/$defs/CriticalityString"},
    "criticality_level": {"oneOf": [{"$ref": "enums.schema.json#/$defs/CriticalityLevel"}, {"type": "null"}]},
    "finding_status": {"oneOf": [{"$ref": "enums.schema.json#/$defs/FindingStatus"}, {"type": "null"}]},
    "risk_level": {"$ref": "enums.schema.json#/$defs/RiskLevel"},
    "confidence": {"$ref": "common.schema.json#/$defs/Confidence"},
    "anchor_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "evidence_ref.schema.json"},
      "description": "Exactly one anchor page per stage (97 §2.5, 93 §2.8: the page depicting the element for the majority of locations), ordered PD, RD, ID; each item has is_anchor = true."
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "evidence_ref.schema.json"},
      "description": "All supporting pages (per-location pages, context, approved changes). Not exported; feeds evidence cards."
    },
    "location_pages": {
      "type": "object",
      "description": "Per location, the pages where it is actually drawn: {location: [{stage, file_id, pdf_page_number}]}. Room 314 of the gold is drawn on RD p20 while the anchor is p18.",
      "additionalProperties": {
        "type": "array",
        "items": {"$ref": "evidence_ref.schema.json"}
      }
    },
    "finding_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "description": "Atomic Findings split from this group, in `locations` order."
    },
    "discovery_method": {"oneOf": [{"$ref": "enums.schema.json#/$defs/DiscoveryMethod"}, {"type": "null"}]},
    "evidence_bind_status": {"oneOf": [{"$ref": "enums.schema.json#/$defs/EvidenceBindStatus"}, {"type": "null"}]},
    "rule_code": {"type": ["string", "null"]},
    "rule_version": {"type": ["string", "null"]},
    "rationale": {"type": ["string", "null"], "description": "Russian, one or two sentences, for the evidence card."},
    "recommendation": {
      "oneOf": [{"$ref": "#/$defs/Recommendation"}, {"type": "null"}]
    },
    "card_no": {"type": ["string", "null"], "pattern": "^Б\\.[1-9][0-9]*$", "description": "Evidence card number in Приложение Б, e.g. «Б.3»."},
    "decision_trace": {"type": ["object", "null"]},
    "ext": {"$ref": "common.schema.json#/$defs/Extension"}
  },
  "allOf": [
    {
      "if": {"properties": {"matrix_scope": {"const": "FREE_SEARCH"}}, "required": ["matrix_scope"]},
      "then": {"properties": {"parameter_code": {"$ref": "common.schema.json#/$defs/FreeParameterCode"}, "parameter_id": {"type": "null"}}},
      "else": {"properties": {"parameter_code": {"$ref": "common.schema.json#/$defs/CanonicalParameterCode"}}}
    },
    {
      "if": {"properties": {"violation_label": {"const": "VIOLATION_PRESENT"}}, "required": ["violation_label"]},
      "then": {"properties": {"protocol_status": {"enum": ["CRITICAL", "WARNING"]}}}
    },
    {
      "if": {"properties": {"violation_label": {"const": "NO_VIOLATION"}}, "required": ["violation_label"]},
      "then": {"properties": {"protocol_status": {"enum": ["OK"]}}}
    },
    {
      "if": {"properties": {"violation_label": {"const": "MISSING_DOCUMENT"}}, "required": ["violation_label"]},
      "then": {"properties": {"protocol_status": {"enum": ["PD_MISSING", "RD_MISSING", "ID_MISSING"]}}}
    },
    {
      "if": {"properties": {"violation_label": {"const": "COMPARISON_IMPOSSIBLE"}}, "required": ["violation_label"]},
      "then": {"properties": {"protocol_status": {"enum": ["COMPARISON_IMPOSSIBLE"]}}}
    }
  ],
  "$defs": {
    "Recommendation": {
      "description": "Draft recommendation for Приложение 2 §7 (93 §5.4). In a preliminary protocol the renderer prefixes «Проект рекомендации (до подтверждения инспектором): ».",
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "template_id": {"type": ["string", "null"], "description": "Id in norms_staging/recommendation_templates.json or the params seed."},
        "text_origin": {"$ref": "enums.schema.json#/$defs/TextOrigin"},
        "work_type": {"type": ["string", "null"], "description": "«Вид работ» of §7.1 (params.work_type)."},
        "normative_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
