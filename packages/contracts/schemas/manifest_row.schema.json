{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.inspector-ai.local/schemas/manifest_row.schema.json",
  "title": "ManifestRow",
  "description": "One row of the organizers' document_manifest.jsonl (schema_version 0.1.0), the registry of the batch mode (97 §2.12). Organizer vocabularies are open: unknown values are kept raw and reported, never rejected. Owner: AG-01.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "file_id",
    "object_id",
    "corpus",
    "dataset_role",
    "split",
    "relative_path",
    "extension",
    "size_bytes",
    "sha256",
    "stage",
    "section",
    "pdf_pages",
    "annotation_status",
    "exclusion_reason",
    "duplicate_group",
    "distribution_status",
    "label_visibility"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "file_id": {"$ref": "common.schema.json#/$defs/ManifestFileId"},
    "object_id": {"$ref": "common.schema.json#/$defs/ObjectId"},
    "corpus": {"type": "string"},
    "dataset_role": {"$ref": "enums.schema.json#/$defs/DatasetRole"},
    "split": {"$ref": "enums.schema.json#/$defs/ManifestSplit"},
    "relative_path": {"type": "string", "minLength": 1, "description": "Relative to <documents root>/01_ДОКУМЕНТАЦИЯ; NFC."},
    "extension": {"type": "string", "pattern": "^\\.[a-z0-9]+$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
    "stage": {"$ref": "enums.schema.json#/$defs/ManifestStage"},
    "section": {"$ref": "enums.schema.json#/$defs/ManifestSection"},
    "pdf_pages": {"type": ["integer", "null"], "minimum": 0},
    "annotation_status": {"$ref": "enums.schema.json#/$defs/AnnotationStatus"},
    "exclusion_reason": {"type": ["string", "null"]},
    "duplicate_group": {"type": ["string", "null"]},
    "distribution_status": {"$ref": "enums.schema.json#/$defs/DistributionStatus"},
    "label_visibility": {"$ref": "enums.schema.json#/$defs/LabelVisibility"}
  }
}
